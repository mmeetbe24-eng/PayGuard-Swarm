# PayGuard Swarm: Environment Configuration Template
# Copy this file to .env and insert your real Sandbox / API credentials.

# Google Gemini API (For live dynamic market parsing)
GEMINI_API_KEY=your_google_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal Developer Sandbox REST API Credentials
# Get your Sandbox API keys at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Cryptographic Enclave Secret (HMAC-SHA256 for Ephemeral Scoped Tokens)
EST_HMAC_SECRET_KEY=payguard_enclave_master_hmac_secret_key_change_me_in_prod

# Application Ports
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Sponsor Track Integrations (Optional)
# Zapier Webhook Trigger for Instant SecOps / Slack / PagerDuty Notifications
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_webhook_id_here/

# Channel3 Agentic Commerce API (Multi-Store Inventory & Real Retail Discovery)
CHANNEL3_API_KEY=your_channel3_api_key_here
